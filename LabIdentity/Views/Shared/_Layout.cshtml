@using System.Globalization
@inject LabIdentity.Configuration.LabSettings SharedSettings

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - LabIdentity</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/LabIdentity.styles.css"
          asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom mb-3">
            <div class="container-fluid">
                <a class="navbar-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    LabIdentity
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="@T["ToggleNavigation"]">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                @T["Home"]
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Polls"
                               asp-action="Index">
                                @T["Polls"]
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Users"
                               asp-action="Index">
                                @T["Users"]
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Archive">
                                @T["Archive"]
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Premium">
                                @T["Premium"]
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Forum">
                                @T["Forum"]
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Privacy">
                                @T["Privacy"]
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex flex-wrap align-items-center gap-3">
                        <partial name="_LoginPartial" />
                        <partial name="_LanguageSwitcher" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @{
        var applicationName =
        ViewData["FooterApplicationName"] as string
        ?? SharedSettings.App.ApplicationName;

        var maxOptionsPerPoll =
        ViewData["FooterMaxOptionsPerPoll"] is int limit
        ? limit
        : SharedSettings.Polling.MaxOptionsPerPoll;
    }

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 · @applicationName ·
            @T["MaxOptionsFooter", maxOptionsPerPoll] ·

            <a asp-area=""
               asp-controller="Home"
               asp-action="Privacy">
                @T["Privacy"]
            </a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>