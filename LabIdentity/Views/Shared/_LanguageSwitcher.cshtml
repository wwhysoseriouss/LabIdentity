@using System.Globalization
@using Microsoft.AspNetCore.WebUtilities

@{
    var path = Context.Request.PathBase
        .Add(Context.Request.Path)
        .ToString();

    var parameters = Context.Request.Query.Where(parameter =>
        !string.Equals(
            parameter.Key,
            "culture",
            StringComparison.OrdinalIgnoreCase)
        && !string.Equals(
            parameter.Key,
            "ui-culture",
            StringComparison.OrdinalIgnoreCase));

    var returnUrl = QueryHelpers.AddQueryString(path, parameters);
}

<form asp-controller="Language"
      asp-action="SetLanguage"
      asp-area=""
      method="post"
      class="d-flex align-items-center gap-2">

    <input type="hidden"
           name="returnUrl"
           value="@returnUrl" />

    <span>@CultureInfo.CurrentUICulture.Name</span>

    <button type="submit"
            name="culture"
            value="uk-UA"
            class="btn btn-sm btn-outline-secondary">
        Українська
    </button>

    <button type="submit"
            name="culture"
            value="en-US"
            class="btn btn-sm btn-outline-secondary">
        English
    </button>

    <button type="submit"
            name="culture"
            value="pl-PL"
            class="btn btn-sm btn-outline-secondary">
        Polski
    </button>
</form>