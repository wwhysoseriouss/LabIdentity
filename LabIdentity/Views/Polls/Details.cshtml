@using System.Security.Claims
@model LabData.Models.Poll

@{
    ViewData["Title"] = T["PollDetails"].Value;

    var now = DateTimeOffset.UtcNow;

    var statusKey = now < Model.OpensAtUtc
        ? "NotStarted"
        : Model.ClosesAtUtc.HasValue
            && now >= Model.ClosesAtUtc.Value
            ? "Finished"
            : "Active";

    var totalVotes = Model.Votes.Count;

    var userId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

    var alreadyVoted = Model.Votes.Any(
        vote => vote.VoterId == userId);

    var isActive = now >= Model.OpensAtUtc
        && (!Model.ClosesAtUtc.HasValue
            || now < Model.ClosesAtUtc.Value);
}

<h1>@Model.Question</h1>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">
        @error
    </div>
}

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="alert">
        @success
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.Description))
{
    <p>@Model.Description</p>
}

<dl class="row">
    <dt class="col-sm-3">@T["Status"]</dt>
    <dd class="col-sm-9">@T[statusKey]</dd>

    <dt class="col-sm-3">@T["OpensAtUtc"]</dt>
    <dd class="col-sm-9">
        @Model.OpensAtUtc.UtcDateTime.ToString("g")
    </dd>

    <dt class="col-sm-3">@T["ClosesAtUtc"]</dt>
    <dd class="col-sm-9">
        @if (Model.ClosesAtUtc.HasValue)
        {
            @Model.ClosesAtUtc.Value.UtcDateTime.ToString("g")
        }
        else
        {
            @T["NoTimeLimit"]
        }
    </dd>

    <dt class="col-sm-3">@T["TotalVotes"]</dt>
    <dd class="col-sm-9">@totalVotes</dd>
</dl>

@if (alreadyVoted)
{
    <div class="alert alert-info">
        @T["AlreadyVotedInfo"]
    </div>
}
else if (!isActive)
{
    <div class="alert alert-secondary">
        @T["VotingUnavailable"]
    </div>
}
else
{
    <h2>@T["YourChoice"]</h2>

    <form asp-controller="Votes"
          asp-action="Cast"
          method="post"
          class="mb-4">

        <input type="hidden"
               name="pollId"
               value="@Model.Id" />

        @foreach (var option in Model.Options.OrderBy(o => o.DisplayOrder))
        {
            <div class="form-check mb-2">
                <input type="radio"
                       class="form-check-input"
                       name="pollOptionId"
                       id="option-@option.Id"
                       value="@option.Id"
                       required />

                <label class="form-check-label"
                       for="option-@option.Id">
                    @option.Text
                </label>
            </div>
        }

        <button type="submit" class="btn btn-success mt-2">
            @T["Vote"]
        </button>
    </form>
}

<h2>@T["OptionsAndResults"]</h2>

<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>@T["AnswerOption"]</th>
                <th>@T["VoteCount"]</th>
                <th>@T["VoteShare"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var option in Model.Options.OrderBy(o => o.DisplayOrder))
            {
                var voteCount = Model.Votes.Count(
                vote => vote.PollOptionId == option.Id);

                var percentage = totalVotes == 0
                ? 0m
                : voteCount * 100m / totalVotes;

                <tr>
                    <td>@option.Text</td>
                    <td>@voteCount</td>
                    <td>@percentage.ToString("N1") %</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (totalVotes == 0)
{
    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-primary">
        @T["Edit"]
    </a>

    <a asp-action="Delete"
       asp-route-id="@Model.Id"
       class="btn btn-danger">
        @T["Delete"]
    </a>
}
else
{
    <p class="text-muted">
        @T["PollEditBlocked"]
    </p>
}

<a asp-action="Index" class="btn btn-secondary">
    @T["BackToList"]
</a>