@model LabData.Models.Poll

@{
    ViewData["Title"] = T["DeletePoll"].Value;
    var hasVotes = Model.Votes.Any();
}

<h1>@ViewData["Title"]</h1>

<h2>@Model.Question</h2>

@if (!string.IsNullOrWhiteSpace(Model.Description))
{
    <p>@Model.Description</p>
}

<dl class="row">
    <dt class="col-sm-4">@T["OptionsCount"]</dt>
    <dd class="col-sm-8">@Model.Options.Count</dd>

    <dt class="col-sm-4">@T["TotalVotes"]</dt>
    <dd class="col-sm-8">@Model.Votes.Count</dd>
</dl>

@if (hasVotes)
{
    <div class="alert alert-warning">
        @T["PollDeleteBlocked"]
    </div>
}
else
{
    <div class="alert alert-danger">
        @T["DeletePollConfirmation"]
    </div>

    <form asp-controller="Polls"
          asp-action="Delete"
          asp-route-id="@Model.Id"
          method="post">

        <button type="submit" class="btn btn-danger">
            @T["ConfirmDelete"]
        </button>
    </form>
}

<a asp-action="Details"
   asp-route-id="@Model.Id"
   class="btn btn-secondary mt-3">
    @T["Cancel"]
</a>