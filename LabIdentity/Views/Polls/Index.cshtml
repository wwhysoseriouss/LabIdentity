@model IEnumerable<LabData.Models.Poll>

@{
    ViewData["Title"] = T["Polls"].Value;
    var now = DateTimeOffset.UtcNow;
}

<h1>@ViewData["Title"]</h1>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="alert">
        @success
    </div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">
        @T["CreatePoll"]
    </a>
</p>

<form asp-action="Index"
      method="get"
      class="d-flex gap-2 mb-3">

    <input type="search"
           name="search"
           value="@ViewData["Search"]"
           class="form-control"
           placeholder="@T["SearchPollsPlaceholder"]"
           aria-label="@T["SearchPollsPlaceholder"]" />

    <button type="submit" class="btn btn-outline-primary">
        @T["Search"]
    </button>

    <a asp-action="Index" class="btn btn-outline-secondary">
        @T["Reset"]
    </a>
</form>

@if (!Model.Any())
{
    <p>@T["NoPollsFound"]</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>@T["Question"]</th>
                    <th>@T["Status"]</th>
                    <th>@T["ClosesAtUtc"]</th>
                    <th>@T["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var poll in Model)
                {
                    var statusKey = now < poll.OpensAtUtc
                    ? "NotStarted"
                    : poll.ClosesAtUtc.HasValue
                    && now >= poll.ClosesAtUtc.Value
                    ? "Finished"
                    : "Active";

                    <tr>
                        <td>@poll.Question</td>
                        <td>@T[statusKey]</td>

                        <td>
                            @if (poll.ClosesAtUtc.HasValue)
                            {
                                @poll.ClosesAtUtc.Value.UtcDateTime.ToString("g")
                            }
                            else
                            {
                                @T["NoTimeLimit"]
                            }
                        </td>

                        <td>
                            <a asp-action="Details"
                               asp-route-id="@poll.Id"
                               class="btn btn-sm btn-outline-primary">
                                @T["Details"]
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}