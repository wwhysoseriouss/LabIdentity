@model LabIdentity.ViewModels.PollFormViewModel

@{
    var actionName = ViewContext.RouteData.Values["action"]?
        .ToString() ?? "Create";

    var isEdit = string.Equals(
        actionName,
        "Edit",
        StringComparison.OrdinalIgnoreCase);

    var pollId = ViewContext.RouteData.Values["id"];

    ViewData["Title"] = T[isEdit ? "EditPoll" : "CreatePoll"].Value;
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-8">
        <form asp-controller="Polls"
              asp-action="@(isEdit ? "Edit" : "Create")"
              asp-route-id="@pollId"
              method="post"
              novalidate>

            <div asp-validation-summary="All"
                 class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Question" class="form-label">
                    @T["Question"]
                </label>

                <input asp-for="Question"
                       class="form-control" />

                <span asp-validation-for="Question"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">
                    @T["Description"]
                </label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="3"></textarea>

                <span asp-validation-for="Description"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DurationHours" class="form-label">
                    @T["DurationHours"]
                </label>

                <input asp-for="DurationHours"
                       class="form-control"
                       aria-describedby="durationHint" />

                <span asp-validation-for="DurationHours"
                      class="text-danger"></span>

                <div id="durationHint" class="form-text">
                    @T["DurationHint"]
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="OptionsText" class="form-label">
                    @T["AnswerOptions"]
                </label>

                <textarea asp-for="OptionsText"
                          class="form-control"
                          rows="6"
                          aria-describedby="optionsHint"></textarea>

                <span asp-validation-for="OptionsText"
                      class="text-danger"></span>

                <div id="optionsHint" class="form-text">
                    @T["OptionsHint"]
                </div>
            </div>

            <button type="submit" class="btn btn-primary">
                @T["Save"]
            </button>

            <a asp-controller="Polls"
               asp-action="Index"
               class="btn btn-secondary">
                @T["BackToList"]
            </a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}