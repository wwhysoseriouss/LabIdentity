@model LabIdentity.ViewModels.RegisterParticipantViewModel

@{
    ViewData["Title"] = T["RegisterParticipant"].Value;
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-controller="Participants"
              asp-action="Register"
              method="post"
              novalidate>

            <div asp-validation-summary="All"
                 class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="FirstName" class="form-label">
                    @T["FirstName"]
                </label>

                <input asp-for="FirstName"
                       class="form-control"
                       autocomplete="given-name" />

                <span asp-validation-for="FirstName"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LastName" class="form-label">
                    @T["LastName"]
                </label>

                <input asp-for="LastName"
                       class="form-control"
                       autocomplete="family-name" />

                <span asp-validation-for="LastName"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">
                    @T["Email"]
                </label>

                <input asp-for="Email"
                       class="form-control"
                       autocomplete="email" />

                <span asp-validation-for="Email"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Age" class="form-label">
                    @T["Age"]
                </label>

                <input asp-for="Age" class="form-control" />

                <span asp-validation-for="Age"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ParticipationCode" class="form-label">
                    @T["ParticipationCode"]
                </label>

                <input asp-for="ParticipationCode"
                       class="form-control" />

                <span asp-validation-for="ParticipationCode"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">
                    @T["Password"]
                </label>

                <input asp-for="Password"
                       class="form-control"
                       autocomplete="new-password" />

                <span asp-validation-for="Password"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label">
                    @T["ConfirmPassword"]
                </label>

                <input asp-for="ConfirmPassword"
                       class="form-control"
                       autocomplete="new-password" />

                <span asp-validation-for="ConfirmPassword"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                @T["Register"]
            </button>

            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-secondary">
                @T["Home"]
            </a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(function () {
            $("#Age").on("change", function () {
                const codeInput = $("#ParticipationCode");

                codeInput.removeData("previousValue");

                if (codeInput.val().trim() !== "") {
                    codeInput.valid();
                }
            });
        });
    </script>
}