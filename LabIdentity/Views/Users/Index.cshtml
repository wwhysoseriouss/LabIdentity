@model IEnumerable<LabData.Data.ApplicationUser>

@{
    ViewData["Title"] = "Користувачі";
}

<h1>Користувачі</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Email</th>
            <th>Ім’я</th>
            <th>Прізвище</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Email</td>
                <td>@user.FirstName</td>
                <td>@user.LastName</td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p>Користувачів поки немає.</p>
}