@model LabIdentity.ViewModels.PagedListViewModel<LabData.Data.ApplicationUser>

@{
    ViewData["Title"] = T["Users"].Value;
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-controller="Participants"
       asp-action="Register"
       class="btn btn-primary">
        @T["RegisterParticipant"]
    </a>
</p>

@if (!Model.Items.Any())
{
    <p>@T["NoUsers"]</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>@T["Email"]</th>
                    <th>@T["FirstName"]</th>
                    <th>@T["LastName"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Items)
                {
                    <tr>
                        <td>@user.Email</td>
                        <td>@user.FirstName</td>
                        <td>@user.LastName</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<partial name="_Pagination" model="Model.Pagination" />